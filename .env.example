# Copy to .env and fill in values

# Local dev: connect to the existing Tellora Postgres (started via root docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5433/tellora

# Production (Railway): use the shared Railway PostgreSQL instance URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Tellora-owned Apollo master API key (free tier works for mixed_people/api_search)
TELLORA_APOLLO_API_KEY=your_apollo_master_key_here

# Optional but strongly recommended — avoids Jina 429s
JINA_API_KEY=your_jina_api_key_here

# Google API key for Gemini (shared with tellora-backend)
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Override for testing — scrape only N pages per profile instead of 500
# MAX_PAGES_PER_PROFILE=2
