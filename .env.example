# Copy to .env and fill in values

# Local dev: connect to the existing Tellora Postgres (started via root docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5433/tellora

# Production (Railway): use the shared Railway PostgreSQL instance URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Railway CLI token (optional local) — `railway login` or set RAILWAY_TOKEN
# RAILWAY_TOKEN=your_railway_token_here

# Tellora-owned Apollo master API key (free tier works for mixed_people/api_search)
TELLORA_APOLLO_API_KEY=your_apollo_master_key_here

# Serper.dev — primary web search (fallback: DDG). Get a key at https://serper.dev
# Without this, the pipeline uses DuckDuckGo only (unreliable at scale).
SERPER_API_KEY=your_serper_api_key_here

# Optional: site: ATS search via Serper when slug detection + guess miss
ATS_SERP_FALLBACK=false

# Optional: httpcloak for WAF-blocked HTML (JazzHR, iCIMS, tech-stack homepage)
# HTTPCLOAK_FALLBACK=false
# pip install httpcloak

# OpenAI — every LLM call and the embeddings (shared with tellora-backend)
OPENAI_API_KEY=your_openai_api_key_here
# Model chain (defaults shown); bare ids are treated as openai/*.
# MODEL_P1=openai/gpt-6-luna
# MODEL_P2=openai/gpt-5.6-luna

# Embeddings (must match the backend's EMBEDDING_PROVIDER / OPENAI_EMBEDDING_MODEL)
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Observability (optional locally; set on Railway for the signal worker)
# Same Sentry project DSN as tellora-backend / recall-backend
ENVIRONMENT=development
SENTRY_DSN=

# Admin API (optional) — Bearer token for POST /admin/jobs/* on signal-worker
# DISCOVERY_ADMIN_SECRET=generate-a-long-random-string
# DISCOVERY_ADMIN_PORT=8080

# Freshness tuning (ARQ worker crons — defaults shown)
# REFRESH_STALE_DAYS=30
# REFRESH_BATCH_CAP=2000
# WATCHED_STALE_DAYS=6
# WATCHED_REFRESH_LIMIT=300
# HEADCOUNT_REFRESH_STALE_DAYS=30
# HEADCOUNT_REFRESH_LIMIT=500


# WARN Act layoff notices — states scraped weekly and how far back notices count
WARN_STATES=ca,tx,ny,wa,il,nj,co,ga,va,or,az,pa,oh,mi,md,fl
WARN_LOOKBACK_DAYS=21
# Wappalyzer-format tech fingerprints (GPL-3.0 data, fetched at runtime)
TECH_FINGERPRINTS_URL=https://raw.githubusercontent.com/HTTPArchive/wappalyzer/main/src
TECH_FINGERPRINTS_CACHE=/tmp/tellora-tech-fingerprints.json
# News / first-party feed items older than this are context, not events
NEWS_EVENT_MAX_AGE_DAYS=45
