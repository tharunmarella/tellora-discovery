meta {
  name: People Search (DevTools profile)
  type: http
  seq: 1
}

post {
  url: https://api.apollo.io/api/v1/mixed_people/api_search
  body: json
  auth: none
}

headers {
  x-api-key: {{apollo_api_key}}
  Content-Type: application/json
  accept: application/json
  Cache-Control: no-cache
}

params:query {
  page: 1
  per_page: 10
  person_titles[]: CEO
  person_seniorities[]: founder
  person_seniorities[]: c_suite
  organization_num_employees_ranges[]: 21,50
  organization_num_employees_ranges[]: 51,200
  organization_locations[]: United States
  q_organization_job_titles[]: platform engineer
  q_organization_job_titles[]: site reliability engineer
  organization_num_jobs_range[min]: 3
  include_similar_titles: true
}

body:json {
  {}
}

docs {
  Key response fields (we read people[].organization):
  - people[].id, people[].name, people[].title
  - people[].organization.id, .name, .primary_domain, .website_url
  - people[].organization.estimated_num_employees
  - total_entries (headcount proxy when × APOLLO_HEADCOUNT_FACTOR)
  - pagination.total_pages

  Filters mirror ICP profile "devtools" in scrape/profiles.py.
  Free tier — does not consume Apollo credits.
}
