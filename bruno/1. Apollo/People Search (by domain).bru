meta {
  name: People Search (by domain)
  type: http
  seq: 2
}

post {
  url: https://api.apollo.io/api/v1/mixed_people/api_search
  body: json
  auth: none
}

headers {
  x-api-key: {{apollo_api_key}}
  Content-Type: application/json
  accept: application/json
}

params:query {
  page: 1
  per_page: 5
  person_titles[]: CEO
  q_organization_domains_list[]: {{company_domain}}
}

body:json {
  {}
}

docs {
  Used for headcount refresh/backfill on known domains.
  Same response shape as profile search; usually 0–1 people per domain.
}
